    # The look is glowing lightning filaments on a DARK background — every palette
    # keeps a near-black ground so the colour blazes. Only the hue shifts by hour.
    "harbor": ((20, 10, 12), [(255, 72, 58), (220, 40, 50), (255, 132, 108), (150, 44, 62)]),       # red — night filaments blaze
    "ember": ((24, 15, 18), [(242, 149, 68), (214, 78, 60), (255, 209, 102), (120, 60, 80)]),       # orange — dawn/dusk fire
    "moss": ((18, 26, 20), [(126, 168, 90), (214, 205, 154), (58, 110, 92), (240, 244, 235)]),      # green — afternoon
    "dune": ((16, 24, 33), [(63, 191, 188), (208, 178, 125), (94, 129, 172), (233, 236, 239)]),     # teal — morning, dark bg
