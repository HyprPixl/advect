# A day in one flow field: same seed → identical geometry, only the light shifts.
# (palette, time-of-day 0=midnight..1, glow, softness). glow stays >0 so the
# stroke geometry (which depends on the glow codepath) is identical every frame.
DAY_CYCLE = [
