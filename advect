#!/usr/bin/env python3
"""advect — generative flow-field wallpapers, straight from the void.

Thousands of particles trace a layered noise field into a painting. Every run
is unique (or use --seed to reproduce one). Stdlib only, writes real PNGs.

  advect                    # render to ~/Pictures/advect/, print path
  advect --set              # render AND set as desktop wallpaper
  advect --palette ember    # harbor | ember | moss | dune
  advect --seed 7 --size 2016x1310
  advect --sharp 0.7 --glow 0.9 --softness 1.5   # crisper lines, brighter, softer glow
  advect --dynamic --set    # a Dynamic .heic that shifts with the time of day
  advect --dynamic --frames 32   # more frames = subtler, more continuous drift
  advect --backend c        # compiled march via cc + ctypes: same seed, ~25x faster
  advect --backend gpu      # MLX on Apple Silicon (best at native/--dynamic scale)
  advect --out ~/wall.png   # write here instead of ~/Pictures/advect/
  advect --progress         # one JSON event per line on stderr, for a GUI host
  advect --preview /tmp/p.png    # keep a small live snapshot of the painting there

Dynamic mode interpolates the MOODS journey into many frames sharing one seed, so
the geometry is frozen and only colour/light drift — subtle, continuous change.

Backends produce the same geometry for a given seed (the diffuse glow layer may
differ by <1 level under GPU's parallel accumulation). Stdlib only for --backend
py/c; gpu needs mlx.
"""

import json
import math
import os
import random
import struct
import subprocess
import sys
import time
import zlib
from array import array

